{% extends 'base.html.twig' %}

{% block title %}CV — Nathan Genillon{% endblock %}

{% block body %}
    <style>
        /* Conserver le style de base mais texte noir */
        body {
            color: #000; /* texte noir */
        }

        .container-cv {
            max-width: 880px;
            margin: 20px auto;
            padding: 24px;
        }

        .card-cv {
            background: #fff;
            border-radius: 12px;
            padding: 28px;
            box-shadow: 0 6px 18px rgba(0,0,0,.08);
        }

        header {
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .avatar {
            width: 96px;
            height: 96px;
            border-radius: 12px;
            background: linear-gradient(135deg, #0b6efd, #7dd3fc);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 700;
            font-size: 28px;
        }

        h1, h2, h3, p, li, a {
            color: #000;
        }

        .meta {
            color: #6b7280;
            margin-top: 6px;
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 20px;
            margin-top: 20px;
        }

        section {
            line-height: 1.5;
        }

        h2 {
            font-size: 14px;
            margin: 0 0 8px 0;
            color: #0b6efd;
        }

        .box {
            background: #fafafa;
            border-radius: 10px;
            padding: 12px;
        }

        ul {
            margin: 8px 0 0 18px;
        }

        .contact {
            font-size: 14px;
        }

        .download-form input, .download-form button {
            width: 100%;
            padding: 8px;
            margin-top: 6px;
            border-radius: 8px;
            border: 1px solid #ccc;
            font-size: 14px;
        }

        .download-form button {
            background-color: #0b6efd;
            color: #fff;
            border: none;
            cursor: pointer;
        }

        @media (max-width: 820px) {
            .grid {
                grid-template-columns: 1fr;
            }

            .avatar {
                width: 76px;
                height: 76px;
            }
        }
    </style>

    <div class="container-cv">
        <div class="card-cv">
            <header>
                <div class="avatar" aria-hidden>NG</div>
                <div>
                    <h1>Nathan GENILLON</h1>
                    <div class="meta">Né le 12/06/2007 — Briennon (42)</div>
                    <div class="contact">
                        <div>Tél : 06 46 85 93 19</div>
                        <div>Email : <a href="mailto:nathan.genillon42@gmail.com">nathan.genillon42@gmail.com</a></div>
                        <div>Adresse : 6 Allée des Bambous, 42720 BRIENNON</div>
                    </div>
                </div>
            </header>

            <div class="grid">
                <main>
                    <section>
                        <h2>Projet professionnel</h2>
                        <div class="box">Recherche entreprise pour de l'alternance pour ma deuxième année de BUT .</div>
                    </section>

                    <section>
                        <h2>Stage en entreprise</h2>
                        <div class="box">Du 19/06 au 23/062023 — Stage informatique au sein de l’entreprise ECONOCOM prestataire de
                            service informatique de la société KNDS à Roanne (ex Nexter).
                            Découverte des différents métiers (Helpdesk, administrateur réseau, …)</div>
                        <div class="box">Du 02/02 au 04/02/2022 — Stage Découverte d’entreprise au sein de Manitowoc à Saint-Nizier sous
                            Charlieu principalement sur les métiers utilisant des outils
                            informatiques (Ingénierie, Notices technique, gestion de production,
                            Qualité)
                        </div>
                    </section>

                    <section>
                        <h2>Compétences & intérêts</h2>
                        <div class="box">
                            <ul>
                                <li>Informatique : Scratch, Python, Word, Excel, PowerPoint</li>
                                <li>Langues : Anglais et Espagnol (niveau scolaire)</li>
                                <li>Sport : Tennis de table en competition , participe à la vie de l’association.</li>
                                <li>Centre d'intérêt : Informatique en général — assemblage de PC, installation de Windows 11,création d'un serveur de stockage NAS et d'un serveur Mincraft.</li>
                            </ul>
                        </div>
                    </section>
                </main>

                <aside>
                    <section>
                        <h2>Informations complémentaires</h2>
                        <div class="box">
                            <p>Permis B</p>
                        </div>
                    </section>

                    <section>
                        <h2>Télécharger</h2>
                        <div class="box">
                            <form class="download-form" id="downloadForm">
                                <input type="text" id="name" name="name" placeholder="Votre nom" required>
                                <input type="email" id="email" name="email" placeholder="Votre email" required>
                                <button type="submit">Télécharger le CV (PDF)</button>
                            </form>
                        </div>
                    </section>
                </aside>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('downloadForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const email = document.getElementById('email').value;
            const name = document.getElementById('name').value;

            if (!email || !name) {
                alert("Veuillez remplir le nom et l'email.");
                return;
            }

            // Vérification simple email
            const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!regex.test(email)) {
                alert("Veuillez entrer un email valide.");
                return;
            }

            // Téléchargement du fichier
            const link = document.createElement('a');
            link.href = '{{ asset("cv_f/CV_Nathan_2025_1.pdf") }}';
            link.download = 'NathanGenillonCV.pdf';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            // Réinitialiser le formulaire (aucune info stockée)
            this.reset();
        });
    </script>

{% endblock %}
