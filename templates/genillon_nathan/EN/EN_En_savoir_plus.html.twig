{% extends 'base.html.twig' %}

{% block title %}Learn More{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4">My Hobbies, Passions, and Projects</h1>

        <div class="row">

            <div class="col-12 col-sm-6 col-md-3 mb-3">
                <div class="card h-20">
                    <img src="/images/photo1.jpg" class="card-img-top" alt="Photo 1">
                    <div class="card-body">
                        <p class="card-text">Description of your first passion.</p>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-md-3 mb-3">
                <div class="card h-100">
                    <img src="/images/setup.jpg" class="card-img-top" alt="Photo 2">
                    <div class="card-body">
                        <p class="card-text">I like video games of all types.</p>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-md-3 mb-3">
                <div class="card h-20">
                    <img src="/images/nas.png" class="card-img-top" alt="Photo 3">
                    <div class="card-body">
                        <p class="card-text">I built a NAS (network-attached storage system).</p>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-md-3 mb-3">
                <div class="card h-100">
                    <img src="/images/img.png" class="card-img-top" alt="Photo 4">
                    <div class="card-body">
                        <p class="card-text">I set up a Minecraft server.</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
{% endblock %}
