{% extends 'base.html.twig' %}

{% block title %}CV — Nathan Genillon{% endblock %}

{% block body %}
    <style>
        /* Keep base style but text in black */
        body {
            color: #000;
        }

        .container-cv {
            max-width: 880px;
            margin: 20px auto;
            padding: 24px;
        }

        .card-cv {
            background: #fff;
            border-radius: 12px;
            padding: 28px;
            box-shadow: 0 6px 18px rgba(0,0,0,.08);
        }

        header {
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .avatar {
            width: 96px;
            height: 96px;
            border-radius: 12px;
            background: linear-gradient(135deg, #0b6efd, #7dd3fc);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 700;
            font-size: 28px;
        }

        h1, h2, h3, p, li, a {
            color: #000;
        }

        .meta {
            color: #6b7280;
            margin-top: 6px;
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 20px;
            margin-top: 20px;
        }

        section {
            line-height: 1.5;
        }

        h2 {
            font-size: 14px;
            margin: 0 0 8px 0;
            color: #0b6efd;
        }

        .box {
            background: #fafafa;
            border-radius: 10px;
            padding: 12px;
        }

        ul {
            margin: 8px 0 0 18px;
        }

        .contact {
            font-size: 14px;
        }

        .download-form input, .download-form button {
            width: 100%;
            padding: 8px;
            margin-top: 6px;
            border-radius: 8px;
            border: 1px solid #ccc;
            font-size: 14px;
        }

        .download-form button {
            background-color: #0b6efd;
            color: #fff;
            border: none;
            cursor: pointer;
        }

        @media (max-width: 820px) {
            .grid {
                grid-template-columns: 1fr;
            }

            .avatar {
                width: 76px;
                height: 76px;
            }
        }
    </style>

    <div class="container-cv">
        <div class="card-cv">
            <header>
                <div class="avatar" aria-hidden>NG</div>
                <div>
                    <h1>Nathan GENILLON</h1>
                    <div class="meta">Born on 12/06/2007 — Briennon (42)</div>
                    <div class="contact">
                        <div>Phone: 06 46 85 93 19</div>
                        <div>Email: <a href="mailto:nathan.genillon42@gmail.com">nathan.genillon42@gmail.com</a></div>
                        <div>Address: 6 Allée des Bambous, 42720 BRIENNON</div>
                    </div>
                </div>
            </header>

            <div class="grid">
                <main>
                    <section>
                        <h2>Professional Project</h2>
                        <div class="box">Looking for a company for a work-study placement for my second year of BUT.</div>
                    </section>

                    <section>
                        <h2>Internship</h2>
                        <div class="box">From 19/06 to 23/06/2023 — IT internship at ECONOCOM, IT service provider for KNDS in Roanne (formerly Nexter).
                            Exploration of different roles (Helpdesk, Network Administrator, …)
                        </div>
                        <div class="box">From 02/02 to 04/02/2022 — Company discovery internship at Manitowoc in Saint-Nizier sous Charlieu,
                            mainly in roles using IT tools (Engineering, Technical manuals, Production management, Quality)
                        </div>
                    </section>

                    <section>
                        <h2>Skills & Interests</h2>
                        <div class="box">
                            <ul>
                                <li>IT: Scratch, Python, Word, Excel, PowerPoint</li>
                                <li>Languages: English and Spanish (school level)</li>
                                <li>Sports: Table tennis in competition, active in the association’s life.</li>
                                <li>Hobbies: General IT — building PCs, installing Windows 11, creating a NAS storage server and a Minecraft server.</li>
                            </ul>
                        </div>
                    </section>
                </main>

                <aside>
                    <section>
                        <h2>Additional Information</h2>
                        <div class="box">
                            <p>Driver's license B</p>
                        </div>
                    </section>

                    <section>
                        <h2>Download</h2>
                        <div class="box">
                            <form class="download-form" id="downloadForm">
                                <input type="text" id="name" name="name" placeholder="Your Name" required>
                                <input type="email" id="email" name="email" placeholder="Your Email" required>
                                <button type="submit">Download CV (PDF)</button>
                            </form>
                        </div>
                    </section>
                </aside>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('downloadForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const email = document.getElementById('email').value;
            const name = document.getElementById('name').value;

            if (!email || !name) {
                alert("Please fill in your name and email.");
                return;
            }

            // Simple email validation
            const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!regex.test(email)) {
                alert("Please enter a valid email address.");
                return;
            }

            // Download file
            const link = document.createElement('a');
            link.href = '{{ asset("cv/CV_Nathan_2025_1.pdf") }}';
            link.download = 'NathanGenillonCV.pdf';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            // Reset form
            this.reset();
        });
    </script>

{% endblock %}
