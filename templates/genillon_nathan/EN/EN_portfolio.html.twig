{% extends 'base.html.twig' %}

{% block title %}Portfolio – Skills{% endblock %}

{% block body %}
    <div class="container">

        <h1>My portfolio</h1>
        <p><strong>BUT Networks & Telecommunications – Semester 1</strong></p>
        <hr>

        <div style="display:flex; justify-content:space-between; gap:20px; flex-wrap:wrap;">

            <!-- RT1 -->
            <div style="flex:1; min-width:250px; border:1px solid #ccc; padding:10px; text-align:center;">
                <h2>
                    <a href="{{ path('app_En_RT1') }}" class="btn btn-link">RT1 - Administer networks and the Internet</a>
                </h2>
                <p>This skill allowed me to learn how to configure and administer a network while following security rules.</p>
                <div style="margin-top:10px;">
                    <img src="{{ asset('images/RT1.png') }}" alt="RT1" style="max-width:100%; height:auto;">
                </div>
            </div>

            <!-- RT2 -->
            <div style="flex:1; min-width:250px; border:1px solid #ccc; padding:10px; text-align:center;">
                <h2>
                    <a href="{{ path('app_En_RT2') }}" class="btn btn-link">RT2 - Connecting companies and users</a>
                </h2>
                <p>This skill taught me how to deploy transmission systems and communicate in a professional environment.</p>
                <div style="margin-top:10px;">
                    <img src="{{ asset('images/RT2.png') }}" alt="RT2" style="max-width:100%; height:auto;">
                </div>
            </div>

            <!-- RT3 -->
            <div style="flex:1; min-width:250px; border:1px solid #ccc; padding:10px; text-align:center;">
                <h2>
                    <a href="{{ path('app_En_RT3') }}" class="btn btn-link">RT3 - Creating tools and software applications for Networks & Telecommunications</a>
                </h2>
                <p>This skill allowed me to develop basic programming abilities and learn how to use development tools.</p>
                <div style="margin-top:10px;">
                    <img src="{{ asset('images/RT3.png') }}" alt="RT3" style="max-width:100%; height:auto;">
                </div>
            </div>

        </div>

    </div>
{% endblock %}
