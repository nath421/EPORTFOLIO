{% extends 'base.html.twig' %}

{% block title %}AC11.02 – System Components{% endblock %}

{% block body %}
    <div class="container">

        <h1>AC11.02 – Identifying Hardware and Software Components</h1>
        <p><strong>Objective:</strong> Identify and describe the main hardware and software components of a digital system.</p>

        <hr>

        <h2>Reflective Analysis</h2>
        <p>
            This activity allowed me to understand the interactions between hardware and software,
            identify components efficiently, and explain their functions. I also learned about system compatibility
            and gained experience in documenting and analyzing a system configuration.
        </p>

        <h2>Evidence Documents</h2>
        <ul>
            <li>Photos or screenshots of hardware components with labels.</li>
            <li>Screenshot showing the operating system and installed software.</li>
            <li>Diagram of the system with main components and interconnections.</li>
            <li>Report listing hardware and software with their functions.</li>
        </ul>

        <h2>Illustrative Image</h2>
        <div style="text-align:center; margin-top:10px;">
            <img src="{{ asset('images/ac1102.png') }}" alt="AC11.02 System Components" style="max-width:100%; height:auto;">
        </div>
        <div style="display:flex; justify-content:space-between; margin-top:30px;">
            <!-- Bouton Précédent (peut être désactivé si AC11.01 est la première) -->
            <a href="{{ path('app_En_ac1101') }}" class="btn btn-secondary">&laquo; AC11.01</a>

            <!-- Bouton Suivant -->
            <a href="{{ path('app_En_ac1103') }}" class="btn btn-primary">NEXT – AC11.03 &raquo;</a>
        </div>

    </div>
{% endblock %}
