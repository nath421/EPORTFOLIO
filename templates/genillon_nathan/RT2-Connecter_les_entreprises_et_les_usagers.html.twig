{% extends 'base.html.twig' %}

{% block title %}RT2 - Connecter les entreprises et les usagers{% endblock %}

{% block body %}
    <div class="container">

        <h1>RT2 - Connecter les entreprises et les usagers</h1>
        <p><strong>Déploiement des supports et systèmes de transmission</strong></p>
        <p><strong>Mise en service et administration des équipements d’accès fixe ou mobile d’un opérateur de télécommunications</strong></p>
        <p><strong>Déploiement et administration des accès sans fil pour l'entreprise</strong></p>
        <p><strong>Déploiement des systèmes de communications</strong></p>
        <hr>

        <div style="display:flex; justify-content:space-between; gap:20px; flex-wrap:wrap;">

            <!-- AC12.01 -->
            <div style="flex:1; min-width:250px; border:1px solid #ccc; padding:10px; text-align:center;">
                <h2>
                    <a href="{{ path('app_ac1201') }}" class="btn btn-link">AC12.01</a>
                </h2>
                <p>Mesurer et analyser des signaux réseau à l’aide d’outils comme Wireshark et les commandes réseau (ping, traceroute)</p>
                <div style="margin-top:10px;">
                    <img src="{{ asset('images/ac1201.png') }}" alt="AC12.01" style="max-width:100%; height:auto;">
                </div>
            </div>

            <!-- AC12.03 -->
            <div style="flex:1; min-width:250px; border:1px solid #ccc; padding:10px; text-align:center;">
                <h2>
                    <a href="{{ path('app_ac1203') }}" class="btn btn-link">AC12.03</a>
                </h2>
                <p>Analyser et comprendre les protocoles de communication réseau (SIP, RTP) dans un environnement de téléphonie IP</p>
                <div style="margin-top:10px;">
                    <img src="{{ asset('images/ac1203.png') }}" alt="AC12.03" style="max-width:100%; height:auto;">
                </div>
            </div>

            <!-- AC12.05 -->
            <div style="flex:1; min-width:250px; border:1px solid #ccc; padding:10px; text-align:center;">
                <h2>
                    <a href="{{ path('app_ac1205') }}" class="btn btn-link">AC12.05</a>
                </h2>
                <p>Déployer et tester les supports de transmission réseau (câbles, liaisons et équipements) pour assurer la connectivité</p>
                <div style="margin-top:10px;">
                    <img src="{{ asset('images/ac1205.png') }}" alt="AC12.05" style="max-width:100%; height:auto;">
                </div>
            </div>

        </div>
        <div style="display:flex; justify-content:space-between; margin-top:30px;">
            <!-- Bouton Précédent  -->
            <a href="{{ path('app_RT1') }}" class="btn btn-primary">&laquo; Retour - RT1 </a>
            <!-- Bouton retoure page Portfolio  -->
            <a href="{{ path('app_portfolio') }}" class="btn btn-secondary">&laquo; Retour au portfolio &raquo;</a>
            <!-- Bouton Suivant -->
            <a href="{{ path('app_RT3') }}" class="btn btn-primary"> Suivant – RT3 &raquo;</a>
        </div>

    </div>
{% endblock %}
