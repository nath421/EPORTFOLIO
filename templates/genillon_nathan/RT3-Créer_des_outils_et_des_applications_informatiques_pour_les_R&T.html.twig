{% extends 'base.html.twig' %}

{% block title %}RT3 - Créer des outils et des applications informatiques pour les R&T{% endblock %}

{% block body %}
    <div class="container">

        <h1>RT3 - Créer des outils et des applications informatiques pour les R&T</h1>
        <p><strong>Conception, déploiement et maintenance du système d’information d’une entreprise</strong></p>
        <p><strong>Automatisation du déploiement et de la maintenance des outils logiciels</strong></p>
        <p><strong>Développement d’outils informatiques à usage interne d'une équipe</strong></p>
        <hr>

        <div style="display:flex; justify-content:space-between; gap:20px; flex-wrap:wrap;">

            <!-- AC13.01 -->
            <div style="flex:1; min-width:250px; border:1px solid #ccc; padding:10px; text-align:center;">
                <h2>
                    <a href="{{ path('app_ac1301') }}" class="btn btn-link">AC13.01</a>
                </h2>
                <p>Installer et configurer un environnement de développement web (Node.js, Git, VS Code, comptes GitHub/Supabase/Vercel)</p>
                <div style="margin-top:10px;">
                    <img src="{{ asset('images/ac1301.png') }}" alt="AC13.01" style="max-width:100%; height:auto;">
                </div>
            </div>

            <!-- AC13.02 -->
            <div style="flex:1; min-width:250px; border:1px solid #ccc; padding:10px; text-align:center;">
                <h2>
                    <a href="{{ path('app_ac1302') }}" class="btn btn-link">AC13.02</a>
                </h2>
                <p>Créer et initialiser une application web React avec Vite et structurer un projet front-end</p>
                <div style="margin-top:10px;">
                    <img src="{{ asset('images/ac1302.png') }}" alt="AC13.02" style="max-width:100%; height:auto;">
                </div>
            </div>

            <!-- AC13.03 -->
            <div style="flex:1; min-width:250px; border:1px solid #ccc; padding:10px; text-align:center;">
                <h2>
                    <a href="{{ path('app_ac1303') }}" class="btn btn-link">AC13.03</a>
                </h2>
                <p>Versionner un projet avec Git et GitHub puis déployer une application web automatiquement avec Vercel (CI/CD)</p>
                <div style="margin-top:10px;">
                    <img src="{{ asset('images/ac1303.png') }}" alt="AC13.03" style="max-width:100%; height:auto;">
                </div>
            </div>

        </div>
        <div style="display:flex; justify-content:space-between; margin-top:30px;">
            <!-- Bouton Précédent  -->
            <a href="{{ path('app_RT2') }}" class="btn btn-primary">&laquo; Retour - RT2 </a>
            <!-- Bouton retoure page Portfolio  -->
            <a href="{{ path('app_portfolio') }}" class="btn btn-secondary">&laquo; Retour au portfolio &raquo;</a>
            <!-- Bouton Suivant -->
            <a href="{{ path('app_RT1') }}" class="btn btn-primary"> Suivant – RT1 &raquo;</a>
        </div>

    </div>
{% endblock %}
