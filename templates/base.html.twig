<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Bienvenue{% endblock %}</title>

    <!-- Bootswatch Quartz (Bootstrap 5) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/quartz/bootstrap.min.css">

    <style>
        html, body {
            height: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
        }

        main {
            flex: 1;
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body>

<!-- NAVBAR -->
{% set currentPath = app.request.pathinfo %} {# Chemin relatif /en/... ou /... #}
{% set enPrefix = '/en' %}
{% set isEnglish = currentPath[:enPrefix|length] == enPrefix %}

<nav class="navbar navbar-expand-lg bg-dark navbar-dark mb-4">
    <div class="container-fluid">
        <a class="navbar-brand" href="{{ isEnglish ? enPrefix ~ path('app_genillon_nathan') : path('app_genillon_nathan') }}">Home</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarColor02">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarColor02">
            <!-- Liens principaux -->
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ isEnglish ? enPrefix ~ path('app_cv') : path('app_cv') }}">CV</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ isEnglish ? enPrefix ~ path('app_portfolio') : path('app_portfolio') }}">Portfolio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ isEnglish ? enPrefix ~ path('app_En_savoir_plus') : path('app_En_savoir_plus') }}">En savoir plus</a>
                </li>
            </ul>

            <ul class="navbar-nav ms-auto">
                {% if isEnglish %}
                    {% set frenchPath = currentPath|slice(enPrefix|length) %}
                    <li class="nav-item">
                        <a class="nav-link btn btn-outline-dark ms-2" href="{{ frenchPath|default('/') }}">
                            Français
                        </a>
                    </li>
                {% else %}
                    {# On est en français, bouton vers l’anglais #}
                    <li class="nav-item">
                        <a class="nav-link btn btn-outline-dark ms-2" href="{{ enPrefix ~ currentPath }}">
                            English
                        </a>
                    </li>
                {% endif %}
            </ul>

        </div>
    </div>
</nav>

<!-- CONTENU -->
<main>
    {% block body %}{% endblock %}
</main>

<!-- FOOTER collé en bas -->
<footer class="bg-dark text-light py-3 mt-auto">
    <div class="container text-center">
        <small>
            2025 © Genillon Nathan - Tous droits réservés - Conditions générales - Politique de confidentialité
        </small>
    </div>
</footer>

<!-- JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
